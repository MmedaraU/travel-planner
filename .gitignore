ENV/
env.bak/
venv.bak/

# ==========================
#  DATABASE (Sensitive Data)
# ==========================
# The app creates travel_planner.db on first launch. WAL mode (set in
# database.py) also produces -wal and -shm sidecars while running.
# None of these belong in version control — they hold your real data.
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
travel_planner.db
travel_planner.db-wal
travel_planner.db-shm
travel_planner.db-journal
backup_*.db
travel_planner_backup_*.db
database_export_*.json
database_export_*.zip

# ==========================
#  RUNTIME STATE FILES
# ==========================
# Written by the app on user action:
#   app_state.json          — last-backup date (monthly reminder)
#   dismissed_warnings.json — acknowledged passport warnings (90 days)
#   weather_cache.json      — cached Open-Meteo responses

app_state.json
dismissed_warnings.json
weather_cache.json

# ==========================
#  USER-GENERATED OUTPUTS
# ==========================
# Itinerary Word docs
generated_itineraries/
# Expense reports
generated_expense_reports/
# Uploaded receipt images (PNG, JPG, PDF), one folder per trip
receipts/
# Calendar files (if temporarily exported locally)
*.ics

# ==========================
#  ENVIRONMENT & CONFIG
# ==========================
.env
.env.local
.env.*
!.env.example
config.local.py

